# Funx configuration. Copy to .env (never commit .env). Placeholders only.
# --- CLI / deploy (cli/config.js) ---
FUNX_REGION=ap-hongkong
FUNX_UIN=100000000000            # owner account id (used for tag-API resource names)
FUNX_NAMESPACE=default
FUNX_BASE_DOMAIN=example.com
FUNX_CERT_ID=                    # SSL certificate id for *.<base domain>
FUNX_RUNTIME=Nodejs18.15
FUNX_DEPLOY_KEY=                 # whitelisted deploy key (hash listed in cli/deploy-keys.json)
# Temporary STS credentials of the deploy role (never long-term keys)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SESSION_TOKEN=
# --- DNS hook for certificates (infra/cert/dnspod-hook.sh) ---
FUNX_DNSPOD_DOMAIN_ID=000000000
# --- API function (api/server.js), set in the function environment ---
FUNX_DB_HOST=db.internal.example
FUNX_DB_PORT=3306
FUNX_DB_NAME=funx
FUNX_DB_USER=funx_user
FUNX_DB_PASSWORD=change-me
FUNX_BOOTSTRAP={"id":"admin","email":"admin@example.com","role":"admin","token_sha256":"<sha256>","expires_at":0}
